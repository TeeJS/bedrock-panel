# dependencies
node_modules/

# build output
dist/
out/
build/

# user runtime config (seeded from app/config.default.json on first run — keeps personal setups out of git)
app/config.json

# local Azure Trusted Signing assets (3rd-party dlib + machine-specific metadata; re-fetched per machine)
.signing/

# logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# timestamped/.old backups of files (never committed)
*.old

# scratch handoff / homework notes (kept local, not part of the repo)
*-HANDOFF.md

# compiled SMTC album-art helper (built from native/smtc-art.cs by build-smtc.js; not a source artifact)
app/native/*.exe
# compiled macOS helpers (built from native/mac/*.swift by build-mac-helpers.js)
app/native/mac/

# dev-app secrets
.env
.ua/
app/native/bedrock_panel_dpapi.node
bedrock-panel-next/
# personal analysis prompt (bundled meeting-analysis-prompt.md stays stock)
/my-meeting-analysis-prompt.md

# transient project-state doc (regenerated locally, not part of the repo)
docs/current-state.md

# IF player runtime saves (created by server.js save-store at runtime; never source)
community-apps/if-player/saves/
X/
.busy-shots/

# Windows-shaped paths a test run can drop in the repository root when the suite is exercised with
# win32 path rules on Linux: os.tmpdir() with no TEMP set resolves to "undefined\temp", and joining
# "/tmp" the Windows way gives "\tmp\...". Neither contains a separator here, so both land as files
# whose NAMES contain backslashes — and a tree holding them cannot be checked out on Windows at all.
/undefined\\*
/\\tmp\\*
