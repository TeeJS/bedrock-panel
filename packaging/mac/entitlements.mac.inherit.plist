<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Electron's helper processes and any bundled helper binaries
  (electron-builder `mac.entitlementsInherit`). See entitlements.mac.plist for the reasoning.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Hardened-runtime resource access for Calendars: without it tccd refuses to even ask ("Policy
       disallows prompt", a silent denial). The calendar-meeting helper reads today's meeting through it. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
</dict>
</plist>
