{
  "id": "photo-strip",
  "name": "Photo Strip",
  "version": "1.0.4",
  "description": "Ambient local-folder photo frame with full-width single-photo and panoramic strip layouts.",
  "entry": "index.html",
  "served": true,
  "server": "server.js",
  "knob": true,
  "hideGridInEditor": true,
  "options": [
    {
      "key": "folder1",
      "label": "Photo folder 1",
      "type": "folder",
      "default": "",
      "serverOnly": true,
      "help": "Choose at least one folder. Paths stay in the trusted host process and are never added to the page URL."
    },
    {
      "key": "folder2",
      "label": "Photo folder 2",
      "type": "folder",
      "default": "",
      "serverOnly": true
    },
    {
      "key": "folder3",
      "label": "Photo folder 3",
      "type": "folder",
      "default": "",
      "serverOnly": true
    },
    {
      "key": "folder4",
      "label": "Photo folder 4",
      "type": "folder",
      "default": "",
      "serverOnly": true
    },
    {
      "key": "interval",
      "label": "Change photo every",
      "type": "select",
      "default": "15",
      "choices": [
        ["5", "5 seconds"],
        ["10", "10 seconds"],
        ["15", "15 seconds"],
        ["30", "30 seconds"],
        ["60", "1 minute"],
        ["300", "5 minutes"]
      ]
    },
    {
      "key": "order",
      "label": "Slideshow order",
      "type": "select",
      "default": "sequential",
      "choices": [
        ["sequential", "Sequential"],
        ["shuffle", "Shuffle"]
      ]
    },
    {
      "key": "mode",
      "label": "Presentation",
      "type": "select",
      "default": "strip",
      "choices": [
        ["strip", "Photo Strip"],
        ["single", "Single Photo"]
      ]
    },
    {
      "key": "fit",
      "label": "Photo fit",
      "type": "select",
      "default": "cover",
      "choices": [
        ["cover", "Cover — crop to fill"],
        ["contain", "Contain — show all"]
      ]
    },
    {
      "key": "transition",
      "label": "Transition",
      "type": "select",
      "default": "fade",
      "choices": [
        ["fade", "Fade"],
        ["slide", "Slide"],
        ["none", "None"]
      ]
    },
    {
      "key": "transitionDuration",
      "label": "Transition duration",
      "type": "select",
      "default": "250",
      "choices": [
        ["150", "150 ms"],
        ["250", "250 ms"],
        ["500", "500 ms"],
        ["1000", "1 second"]
      ]
    },
    {
      "key": "kenBurns",
      "label": "Ken Burns motion",
      "type": "bool",
      "default": false,
      "showIf": { "key": "mode", "value": "single" },
      "help": "Adds a very slow, subtle pan and zoom to single-photo mode."
    },
    {
      "key": "recursive",
      "label": "Include subfolders",
      "type": "bool",
      "default": false,
      "serverOnly": true,
      "help": "Off by default. Recursive scans are capped to protect the panel from unexpectedly large folder trees."
    },
    {
      "key": "maxPhotos",
      "label": "Maximum library size",
      "type": "select",
      "default": "500",
      "serverOnly": true,
      "choices": [
        ["100", "100 photos"],
        ["250", "250 photos"],
        ["500", "500 photos — recommended"],
        ["1000", "1,000 photos"],
        ["2500", "2,500 photos"],
        ["10000", "10,000 photos — maximum"]
      ],
      "help": "Maximum number of photos indexed across all selected folders. A smaller limit makes large or network-hosted libraries start faster."
    },
    {
      "key": "showMetadata",
      "label": "Show filename and date",
      "type": "bool",
      "default": false
    },
    {
      "key": "allowDelete",
      "label": "Allow deleting photos",
      "type": "bool",
      "default": false,
      "help": "Shows a Delete control on the panel. Every deletion requires confirmation and moves the photo to the operating system Recycle Bin or Trash."
    },
    {
      "key": "allowDirectDelete",
      "label": "Allow direct delete fallback",
      "type": "bool",
      "default": false,
      "showIf": { "key": "allowDelete", "value": true },
      "help": "For network shares where Windows cannot use the Recycle Bin. If recycling fails, deletes directly from the share; recovery depends on the NAS recycle bin configuration."
    }
  ]
}
