{
  "id": "omlx-monitor",
  "name": "oMLX Monitor",
  "version": "1.1.1",
  "description": "Live view of one or more oMLX servers (omlx.ai) on the panel: loaded models with memory, requests in flight with tokens per second, queue, throughput and cache totals, memory pressure, and one-tap load/unload. Talks to each server through its own API key.",
  "entry": "index.html",
  "served": true,
  "server": "server.js",
  "knob": true,
  "options": [
    {
      "key": "url1",
      "label": "Server URL",
      "type": "text",
      "default": "http://127.0.0.1:8000",
      "help": "The oMLX dashboard address without the /admin part."
    },
    {
      "key": "key1",
      "label": "API key",
      "type": "secret",
      "default": "",
      "serverOnly": true,
      "help": "The server's main API key (Admin → Settings). Stays on this Mac. The main key also unlocks the admin data — per-model activity, memory pressure, load/unload; a sub key gives the basic status only."
    },
    {
      "key": "more2",
      "label": "Add another server",
      "type": "bool",
      "default": false
    },
    {
      "key": "url2",
      "label": "Server 2 URL",
      "type": "text",
      "default": "",
      "showIf": {
        "key": "more2",
        "value": true
      }
    },
    {
      "key": "key2",
      "label": "Server 2 API key",
      "type": "secret",
      "default": "",
      "serverOnly": true,
      "showIf": {
        "key": "more2",
        "value": true
      }
    },
    {
      "key": "more3",
      "label": "Add another server",
      "type": "bool",
      "default": false,
      "showIf": {
        "key": "more2",
        "value": true
      }
    },
    {
      "key": "url3",
      "label": "Server 3 URL",
      "type": "text",
      "default": "",
      "showIf": [
        {
          "key": "more2",
          "value": true
        },
        {
          "key": "more3",
          "value": true
        }
      ]
    },
    {
      "key": "key3",
      "label": "Server 3 API key",
      "type": "secret",
      "default": "",
      "serverOnly": true,
      "showIf": [
        {
          "key": "more2",
          "value": true
        },
        {
          "key": "more3",
          "value": true
        }
      ]
    },
    {
      "key": "allowControl",
      "label": "Show Load / Unload buttons",
      "type": "bool",
      "default": true
    }
  ]
}
